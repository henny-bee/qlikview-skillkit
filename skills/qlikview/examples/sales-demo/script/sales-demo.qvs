///$tab Main
//==============================================================================================
//  QLIK-CL  -  "CL Distribution" sales demo
//----------------------------------------------------------------------------------------------
//  Fictional pan-European B2B distributor of IT hardware and accessories. Currency: EUR.
//  The complete data set is GENERATED by this script (no source files needed):
//
//    Invoices      900,000 invoice lines            fact
//    CreditNotes   100,000 credit-note lines        fact, derived from real invoice lines
//    Budget        sales rep x month 2024..2026     fact (40 x 36 = 1,440 rows)
//    Calendar, Customers, Products, SalesReps, Channels, ReturnReasons    dimensions
//
//  The three facts meet the dimensions through one LinkTable (%LinkKey): no synthetic keys,
//  no loops. Generation is deterministic (hash-based pseudo-random numbers, no Rand()), so
//  every reload produces exactly the same numbers.
//
//  Tabs: Main | Config | Dimensions | Calendar | Invoices | CreditNotes | Budget | LinkTable
//        | Variables | Cleanup
//  Source of truth: _build/script/QLIK-CL.qvs (Engineer). Interface: _build/spec/data-contract.md
//==============================================================================================
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='€ #,##0.00;-€ #,##0.00';
SET TimeFormat='hh:mm:ss';
SET DateFormat='DD/MM/YYYY';
SET TimestampFormat='DD/MM/YYYY hh:mm:ss[.fff]';
SET FirstWeekDay=0;
SET BrokenWeeks=0;
SET ReferenceDay=4;
SET FirstMonthOfYear=1;
SET CollationLocale='en-GB';
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sept;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';

SET HidePrefix='%';                         // %-prefixed technical keys are hidden in the UI

///$tab Config
//----------------------------------------------------------------------------------------------
//  Configuration: volumes, data window, generator settings
//----------------------------------------------------------------------------------------------

// Volumes. Change these two numbers to scale the demo; all other steps adapt automatically.
SET vCfgInvoiceLines    = 900000;           // invoice lines (exact)
SET vCfgCreditNoteLines = 100000;           // credit-note lines (exact)
SET vCfgSalesReps       = 40;               // 8 teams x 5 reps (see SalesReps)

// Data window: transactions 01/01/2024 .. 30/09/2026. The calendar runs to 31/12/2026
// because the budget covers the full year 2026.
LET vCfgStartDateNum  = Num(MakeDate(2024, 1, 1));
LET vCfgEndDateNum    = Num(MakeDate(2026, 9, 30));
LET vCfgCalEndDateNum = Num(MakeDate(2026, 12, 31));

// Invoice structure: a line opens a new invoice with this probability (~5 lines per invoice).
SET vCfgNewInvoiceProb     = 0.18;
SET vCfgMaxLinesPerInvoice = 12;

// Story 1: start of the Networking quality issue (it ramps up until the end of the window).
LET vCfgIssueStartNum = Num(MakeDate(2024, 10, 1));

// Deterministic pseudo-random number in [0,1):   $(fRnd(<integer>, <stream>))
// Classic hash Frac(Sin(n * 12.9898 + stream * 78.233) * 43758.5453). The same input always
// gives the same output; different streams give independent numbers for the same record.
// Pass plain field names or arithmetic as arguments (no commas or brackets inside).
SET fRnd = Frac(Sin(($1) * 12.9898 + ($2) * 78.233) * 43758.5453);

///$tab Dimensions
//----------------------------------------------------------------------------------------------
//  Dimensions: Channels, ReturnReasons, SalesReps, Customers, Products
//----------------------------------------------------------------------------------------------

// ---- Sales channels ---------------------------------------------------------------------------
Channels:
LOAD * INLINE [
ChannelID, Channel
1, Direct Sales
2, E-Commerce
3, Distributor
4, Retail Partner
];

// ---- Return reasons (credit notes) -----------------------------------------------------------
ReturnReasons:
LOAD * INLINE [
ReturnReasonID, ReturnReason, ReturnReasonGroup
1, Damaged in transit, Logistics
2, Wrong item delivered, Logistics
3, Late delivery, Logistics
4, Quality defect, Quality
5, Dead on arrival, Quality
6, Pricing error, Commercial
7, Order cancelled, Commercial
8, Goodwill credit, Commercial
];

// ---- Sales organisation: 8 teams x 5 reps. Teams cover the customer regions;
//      DACH is split into North and South. SalesRepID = 100 + (team - 1) * 5 + rep.
SalesReps:
LOAD * INLINE [
SalesRepID, SalesRepName, SalesTeam, SalesManager, SalesRepRegion
101, Lukas Brenner, DACH North, Katrin Albers, DACH
102, Anna Schröder, DACH North, Katrin Albers, DACH
103, Jonas Krüger, DACH North, Katrin Albers, DACH
104, Mia Hoffmann, DACH North, Katrin Albers, DACH
105, Felix Wagner, DACH North, Katrin Albers, DACH
106, Sophie Gruber, DACH South, Stefan Huber, DACH
107, Maximilian Steiner, DACH South, Stefan Huber, DACH
108, Laura Baumann, DACH South, Stefan Huber, DACH
109, Tobias Moser, DACH South, Stefan Huber, DACH
110, Lea Fischer, DACH South, Stefan Huber, DACH
111, Daan Jansen, Benelux, Pieter de Vries, Benelux
112, Emma Peeters, Benelux, Pieter de Vries, Benelux
113, Lars van Dijk, Benelux, Pieter de Vries, Benelux
114, Sanne Willems, Benelux, Pieter de Vries, Benelux
115, Thomas Claes, Benelux, Pieter de Vries, Benelux
116, Erik Johansson, Nordics, Ingrid Lindqvist, Nordics
117, Freja Nielsen, Nordics, Ingrid Lindqvist, Nordics
118, Mikko Virtanen, Nordics, Ingrid Lindqvist, Nordics
119, Ida Hansen, Nordics, Ingrid Lindqvist, Nordics
120, Oskar Berg, Nordics, Ingrid Lindqvist, Nordics
121, Oliver Bennett, UK & Ireland, James Whitfield, UK & Ireland
122, Charlotte Hughes, UK & Ireland, James Whitfield, UK & Ireland
123, Liam Connolly, UK & Ireland, James Whitfield, UK & Ireland
124, Amelia Clarke, UK & Ireland, James Whitfield, UK & Ireland
125, Harry Patel, UK & Ireland, James Whitfield, UK & Ireland
126, Lucas Martin, France, Claire Dubois, France
127, Camille Laurent, France, Claire Dubois, France
128, Hugo Bernard, France, Claire Dubois, France
129, Chloé Lefèvre, France, Claire Dubois, France
130, Antoine Moreau, France, Claire Dubois, France
131, Alejandro García, Southern Europe, Marco Bellini, Southern Europe
132, Giulia Romano, Southern Europe, Marco Bellini, Southern Europe
133, Pablo Fernández, Southern Europe, Marco Bellini, Southern Europe
134, Francesca Conti, Southern Europe, Marco Bellini, Southern Europe
135, Tiago Silva, Southern Europe, Marco Bellini, Southern Europe
136, Piotr Kowalski, CEE, Tomasz Nowicki, CEE
137, Kateřina Nováková, CEE, Tomasz Nowicki, CEE
138, Bence Horváth, CEE, Tomasz Nowicki, CEE
139, Andrei Popescu, CEE, Tomasz Nowicki, CEE
140, Zuzana Kováčová, CEE, Tomasz Nowicki, CEE
];

// ---- Geography: cities per customer region ---------------------------------------------------
// _CityNo is ordered by business weight (city 1 gets the most customers).
// _TeamNo = sales team that covers the city (1 DACH North, 2 DACH South, 3 Benelux, 4 Nordics,
// 5 UK & Ireland, 6 France, 7 Southern Europe, 8 CEE).
TmpCity:
LOAD *, _RegionNo * 100 + _CityNo AS _CityKey
INLINE [
_RegionNo, _CityNo, City, Country, LegalForm, _TeamNo
1, 1, Berlin, Germany, GmbH, 1
1, 2, Munich, Germany, GmbH, 2
1, 3, Hamburg, Germany, GmbH, 1
1, 4, Frankfurt, Germany, GmbH, 1
1, 5, Vienna, Austria, GmbH, 2
1, 6, Zurich, Switzerland, AG, 2
1, 7, Cologne, Germany, GmbH, 1
1, 8, Stuttgart, Germany, GmbH, 2
1, 9, Düsseldorf, Germany, GmbH, 1
1, 10, Leipzig, Germany, GmbH, 1
1, 11, Geneva, Switzerland, SA, 2
1, 12, Basel, Switzerland, AG, 2
1, 13, Graz, Austria, GmbH, 2
1, 14, Linz, Austria, GmbH, 2
2, 1, Amsterdam, Netherlands, B.V., 3
2, 2, Brussels, Belgium, NV, 3
2, 3, Rotterdam, Netherlands, B.V., 3
2, 4, Antwerp, Belgium, NV, 3
2, 5, Utrecht, Netherlands, B.V., 3
2, 6, Eindhoven, Netherlands, B.V., 3
2, 7, Ghent, Belgium, NV, 3
2, 8, Luxembourg, Luxembourg, S.A., 3
3, 1, Stockholm, Sweden, AB, 4
3, 2, Copenhagen, Denmark, A/S, 4
3, 3, Oslo, Norway, AS, 4
3, 4, Helsinki, Finland, Oy, 4
3, 5, Gothenburg, Sweden, AB, 4
3, 6, Aarhus, Denmark, A/S, 4
3, 7, Malmö, Sweden, AB, 4
3, 8, Bergen, Norway, AS, 4
3, 9, Espoo, Finland, Oy, 4
4, 1, London, United Kingdom, Ltd, 5
4, 2, Manchester, United Kingdom, Ltd, 5
4, 3, Dublin, Ireland, Ltd, 5
4, 4, Birmingham, United Kingdom, Ltd, 5
4, 5, Leeds, United Kingdom, Ltd, 5
4, 6, Glasgow, United Kingdom, Ltd, 5
4, 7, Bristol, United Kingdom, Ltd, 5
4, 8, Edinburgh, United Kingdom, Ltd, 5
4, 9, Cork, Ireland, Ltd, 5
5, 1, Paris, France, SAS, 6
5, 2, Lyon, France, SAS, 6
5, 3, Marseille, France, SAS, 6
5, 4, Toulouse, France, SAS, 6
5, 5, Lille, France, SAS, 6
5, 6, Nantes, France, SAS, 6
5, 7, Bordeaux, France, SAS, 6
5, 8, Strasbourg, France, SAS, 6
6, 1, Madrid, Spain, S.L., 7
6, 2, Milan, Italy, S.r.l., 7
6, 3, Barcelona, Spain, S.L., 7
6, 4, Rome, Italy, S.r.l., 7
6, 5, Lisbon, Portugal, Lda., 7
6, 6, Turin, Italy, S.r.l., 7
6, 7, Valencia, Spain, S.L., 7
6, 8, Bologna, Italy, S.r.l., 7
6, 9, Porto, Portugal, Lda., 7
6, 10, Seville, Spain, S.L., 7
7, 1, Warsaw, Poland, Sp. z o.o., 8
7, 2, Prague, Czech Republic, s.r.o., 8
7, 3, Budapest, Hungary, Kft., 8
7, 4, Bucharest, Romania, S.R.L., 8
7, 5, Kraków, Poland, Sp. z o.o., 8
7, 6, Brno, Czech Republic, s.r.o., 8
7, 7, Wrocław, Poland, Sp. z o.o., 8
7, 8, Bratislava, Slovakia, s.r.o., 8
7, 9, Cluj-Napoca, Romania, S.R.L., 8
7, 10, Gdańsk, Poland, Sp. z o.o., 8
];

MapCityName:    MAPPING LOAD _CityKey, City      RESIDENT TmpCity;
MapCityCountry: MAPPING LOAD _CityKey, Country   RESIDENT TmpCity;
MapCityLegal:   MAPPING LOAD _CityKey, LegalForm RESIDENT TmpCity;
MapCityTeam:    MAPPING LOAD _CityKey, _TeamNo   RESIDENT TmpCity;
DROP TABLE TmpCity;

// ---- Customers: 5,000 ------------------------------------------------------------------------
// Internal index _CustIdx = region block + size rank inside the region (rank 0 = biggest).
// Region blocks:  DACH 1150 | Benelux 550 | Nordics 500 | UK & Ireland 700 | France 650 |
//                 Southern Europe 850 | CEE 600.
// CustomerID scrambles the index (10001 + idx * 2017 mod 5000; 2017 is coprime to 5000), so
// IDs do not reveal size. Segment follows size (top 4 % Enterprise, next 18 % Mid-Market),
// plus ~10 % Public Sector of any size. Each customer has one account manager (sales rep).
TmpCustomers:
LOAD
    CustomerID,
    _RegionNo,
    _CityKey,
    _SegNo,
    100 + (_TeamNo - 1) * 5 + 1
        - (_uRep >= 0.28) - (_uRep >= 0.52) - (_uRep >= 0.72) - (_uRep >= 0.88)  AS _RepID,
    // corporate name: unique by construction (40 x 12 x 11 combinations indexed by CustomerID)
    SubField('Alpen;Nord;Blue;Vertex;Kappa;Delta;Sigma;Orion;Atlas;Nova;Prime;Apex;Fusion;Silver;Iron;Green;Cloud;Data;Pixel;Quantum;Metro;Euro;Rhein;Baltic;Adria;Iberia;Celtic;Hansa;Alto;Terra;Sol;Luna;Polar;Crest;Summit;Harbor;River;Stone;Bright;Clear', ';', Mod(_n, 40) + 1)
      & SubField('tech;soft;net;works;logic;point;line;bridge;wave;core;field;gate', ';', Mod(Div(_n, 40), 12) + 1)
      & ' ' & SubField('IT Services;Solutions;Consulting;Group;Systems;Digital;Partners;Engineering;Logistics;Media;Retail', ';', Div(_n, 480) + 1)
      & ' ' & ApplyMap('MapCityLegal', _CityKey)                               AS _CorpName,
    Pick(_SegNo, 'Enterprise', 'Mid-Market', 'SMB', 'Public Sector')           AS CustomerSegment,
    ApplyMap('MapCityName', _CityKey)                                          AS CustomerCity,
    ApplyMap('MapCityCountry', _CityKey)                                       AS CustomerCountry,
    Pick(_RegionNo, 'DACH', 'Benelux', 'Nordics', 'UK & Ireland', 'France',
                    'Southern Europe', 'CEE')                                  AS CustomerRegion,
    Date(MakeDate(2008, 1, 1) + Floor(_uSince * (MakeDate(2023, 12, 31) - MakeDate(2008, 1, 1))))
                                                                               AS CustomerSince;
LOAD *,
    If(_uPublic < 0.10, 4, If(_SizeQ < 0.04, 1, If(_SizeQ < 0.22, 2, 3)))      AS _SegNo,
    ApplyMap('MapCityTeam', _CityKey, 0)                                       AS _TeamNo,
    CustomerID - 10001                                                         AS _n;
LOAD *,
    10001 + Mod(_CustIdx * 2017, 5000)                                         AS CustomerID,
    (_CustIdx - Pick(_RegionNo, 0, 1150, 1700, 2200, 2900, 3550, 4400))
        / Pick(_RegionNo, 1150, 550, 500, 700, 650, 850, 600)                  AS _SizeQ,
    _RegionNo * 100 + 1
        + Floor(Pick(_RegionNo, 14, 8, 9, 9, 8, 10, 10) * Pow(_uCity, 1.7))    AS _CityKey;
LOAD
    _CustIdx,
    1 - (_CustIdx >= 1150) - (_CustIdx >= 1700) - (_CustIdx >= 2200)
      - (_CustIdx >= 2900) - (_CustIdx >= 3550) - (_CustIdx >= 4400)           AS _RegionNo,
    $(fRnd(_CustIdx, 101))                                                     AS _uCity,
    $(fRnd(_CustIdx, 102))                                                     AS _uPublic,
    $(fRnd(_CustIdx, 103))                                                     AS _uSince,
    $(fRnd(_CustIdx, 104))                                                     AS _uRep;
LOAD
    RecNo() - 1                                                                AS _CustIdx
AUTOGENERATE 5000;

// lookups used by the invoice generator
MapCustSeg: MAPPING LOAD CustomerID, _SegNo RESIDENT TmpCustomers;
MapCustRep: MAPPING LOAD CustomerID, _RepID RESIDENT TmpCustomers;

// Public-sector customers are named after their city ("Lyon University Hospital"). A running
// number per city keeps the names unique.
TmpCustomers2:
NOCONCATENATE
LOAD
    *,
    If(CustomerCity = Peek('CustomerCity') and _SegNo = Peek('_SegNo'),
       Peek('_CitySeq') + 1, 1)                                                AS _CitySeq
RESIDENT TmpCustomers
ORDER BY CustomerCity, _SegNo, CustomerID;
DROP TABLE TmpCustomers;

Customers:
LOAD
    CustomerID,
    If(_SegNo = 4,
       CustomerCity & ' '
         & SubField('City Council;University;University Hospital;Regional Government;Police Service;Tax Office;Public Library;Water Authority;Transport Authority;School Board;Fire & Rescue Service;Courts Administration',
                    ';', Mod(_CitySeq - 1, 12) + 1)
         & If(_CitySeq > 12, ' ' & (Div(_CitySeq - 1, 12) + 1)),
       _CorpName)                                                              AS CustomerName,
    CustomerSegment,
    CustomerCity,
    CustomerCountry,
    CustomerRegion,
    CustomerSince
RESIDENT TmpCustomers2
ORDER BY CustomerID;
DROP TABLE TmpCustomers2;

// ---- Products: 600 = 6 categories x 4 groups x 25 products ------------------------------------
// ProductID 1001..1600 in category blocks of 100. Inside a block, _j is the popularity rank and
// the group rotates with _j, so every group has popular and slow-moving items.
// List price is log-uniform inside the group's price band; standard cost = list price x
// category cost ratio (+/- 6 %).
TmpProducts:
LOAD
    ProductID,
    Brand & ' ' & Pick(_GrpNo,
        'WorkBook', 'Slim', 'Tower', 'Creator WS',
        'View', 'ColorPro', 'Signage', 'Beam',
        'Switch', 'AirPoint', 'Gate', 'Link',
        'SSD', 'Go Drive', 'NAS', 'Vault',
        'Desk Set', 'Voice', 'Dock', 'Print',
        'OS License', 'Office Suite', 'Secure', 'CarePlus')
      & ' ' & (100 + Div(_j, 4) * 20)
      & Pick(Mod(_j * 7, 5) + 1, '', ' Pro', '', ' Plus', ' Max')              AS ProductName,
    Pick(_GrpNo,
        'Business Notebooks', 'Ultrabooks', 'Desktop PCs', 'Workstations',
        'Office Monitors', 'Professional Monitors', 'Large Format Displays', 'Projectors',
        'Switches', 'Wireless Access Points', 'Routers & Firewalls', 'Cables & Transceivers',
        'Internal SSDs', 'External Drives', 'NAS Systems', 'SAN & Backup',
        'Keyboards & Mice', 'Headsets', 'Docking Stations', 'Printers',
        'Operating Systems', 'Office & Collaboration', 'Security Software', 'Warranty & Services')
                                                                               AS ProductGroup,
    Pick(_CatNo, 'Notebooks & PCs', 'Monitors & Displays', 'Networking', 'Storage',
                 'Peripherals', 'Software & Services')                         AS ProductCategory,
    Brand,
    ProductListPrice,
    Round(ProductListPrice * Pick(_CatNo, 0.80, 0.74, 0.64, 0.70, 0.60, 0.52)
          * (0.94 + 0.12 * _uCost), 0.01)                                      AS ProductStdCost;
LOAD *,
    If(_RawPrice >= 100, Round(_RawPrice, 10) - 1, Round(_RawPrice) - 0.01)    AS ProductListPrice,
    SubField(Pick(_CatNo, 'Novix;Corvana;Veloxa', 'Corvana;Bluepeak;Veloxa', 'Teralink;Arcwave',
                          'Stratos;Bluepeak;Arcwave', 'Orbiq;Novix;Bluepeak', 'Orbiq;Stratos;Teralink'),
             ';', 1 + Floor(_uBrand * Pick(_CatNo, 3, 3, 2, 3, 3, 3)))         AS Brand;
LOAD *,
    // price band per group (min .. max list price in EUR)
    Pick(_GrpNo,  650,  900,  450, 1400,  120,  380,  900,  450,  180,  120,  250,    9,
                   45,   59,  290, 2400,   19,   29,  119,  149,   89,   99,   25,   49)
  * Pow(Pick(_GrpNo, 1600, 2200, 1200, 4200,  320, 1400, 4500, 2400, 4800,  950, 5500,  180,
                      420,  320, 3200, 12000, 149,  249,  329, 1200,  290,  480,  140,  890)
      / Pick(_GrpNo,  650,  900,  450, 1400,  120,  380,  900,  450,  180,  120,  250,    9,
                       45,   59,  290, 2400,   19,   29,  119,  149,   89,   99,   25,   49),
        _uPrice)                                                               AS _RawPrice;
LOAD
    1001 + _ProdIdx                                                            AS ProductID,
    Div(_ProdIdx, 100) + 1                                                     AS _CatNo,
    Mod(_ProdIdx, 100)                                                         AS _j,
    Div(_ProdIdx, 100) * 4 + Mod(_ProdIdx, 4) + 1                              AS _GrpNo,
    $(fRnd(_ProdIdx, 201))                                                     AS _uBrand,
    $(fRnd(_ProdIdx, 202))                                                     AS _uPrice,
    $(fRnd(_ProdIdx, 203))                                                     AS _uCost;
LOAD
    RecNo() - 1                                                                AS _ProdIdx
AUTOGENERATE 600;

MapProdPrice: MAPPING LOAD ProductID, ProductListPrice RESIDENT TmpProducts;
MapProdCost:  MAPPING LOAD ProductID, ProductStdCost   RESIDENT TmpProducts;
RENAME TABLE TmpProducts TO Products;

///$tab Calendar
//----------------------------------------------------------------------------------------------
//  Calendar: one row per day, 01/01/2024 .. 31/12/2026 (1,096 days)
//  Period flags (1/0, never null) are relative to the data end date 30/09/2026.
//----------------------------------------------------------------------------------------------
Calendar:
LOAD
    %DateKey,
    Date(%DateKey)                                                             AS Date,
    Year(%DateKey)                                                             AS Year,
    Dual('Q' & Ceil(Month(%DateKey) / 3), Ceil(Month(%DateKey) / 3))           AS Quarter,
    Month(%DateKey)                                                            AS Month,
    Dual(Year(%DateKey) & '-Q' & Ceil(Month(%DateKey) / 3),
         Year(%DateKey) * 10 + Ceil(Month(%DateKey) / 3))                      AS YearQuarter,
    Date(MonthStart(%DateKey), 'MMM YYYY')                                     AS YearMonth,
    Week(%DateKey)                                                             AS Week,
    WeekDay(%DateKey)                                                          AS Weekday,
    Day(%DateKey)                                                              AS Day,
    -InYearToDate(%DateKey, $(vCfgEndDateNum), 0)                              AS Flag_CYTD,   // 01/01/2026 - 30/09/2026
    -InYearToDate(%DateKey, $(vCfgEndDateNum), -1)                             AS Flag_PYTD,   // 01/01/2025 - 30/09/2025
    -(%DateKey > AddMonths($(vCfgEndDateNum), -12)
      and %DateKey <= $(vCfgEndDateNum))                                       AS Flag_R12,    // 01/10/2025 - 30/09/2026
    -(%DateKey > AddMonths($(vCfgEndDateNum), -24)
      and %DateKey <= AddMonths($(vCfgEndDateNum), -12))                       AS Flag_PR12,   // 01/10/2024 - 30/09/2025
    -InMonth(%DateKey, $(vCfgEndDateNum), 0)                                   AS Flag_CM,     // Sep 2026
    -InMonth(%DateKey, $(vCfgEndDateNum), -1)                                  AS Flag_PM,     // Aug 2026
    -InMonth(%DateKey, $(vCfgEndDateNum), -12)                                 AS Flag_PYM;    // Sep 2025
LOAD
    $(vCfgStartDateNum) + RecNo() - 1                                          AS %DateKey
AUTOGENERATE $(vCfgCalEndDateNum) - $(vCfgStartDateNum) + 1;

///$tab Invoices
//----------------------------------------------------------------------------------------------
//  Invoices (fact): exactly vCfgInvoiceLines lines
//    1. Day plan      how many lines each day gets (growth x seasonality x weekday x noise)
//    2. Line skeleton one row per line, split into invoices of ~5 lines
//    3. Header        customer (region mix drifts over time), rep, channel, terms, invoice no.
//    4. Lines         product, quantity, price, discount, cost
//----------------------------------------------------------------------------------------------

// ---- 1. Day plan -------------------------------------------------------------------------------
TmpDayPlan:
LOAD *,
    Alt(Peek('_DayCumW'), 0)                                                   AS _DayCumPrev,
    RangeSum(Peek('_DayCumW'), _DayW)                                          AS _DayCumW;
LOAD
    _DayNum,
    Pick(Year(_DayNum) - 2023, 1.00, 1.070, 1.155)                    // volume level (net sales: ~+8 % 2025, ~+5 % 2026)
  * Pick(Month(_DayNum), 0.86, 0.93, 1.06, 0.98, 0.99, 1.03,
                         0.93, 0.72, 1.05, 1.08, 1.17, 1.22)          // August dip, Q4 peak
  * Pick(WeekDay(_DayNum) + 1, 1.00, 1.06, 1.06, 1.02, 0.92, 0.14, 0.06)   // quiet weekends
  * If(Match(Month(_DayNum) * 100 + Day(_DayNum), 101, 1224, 1225, 1226, 1231), 0.15, 1)  // holidays
  * (0.88 + 0.24 * $(fRnd(_DayNum, 1)))                               // daily noise +/- 12 %
                                                                               AS _DayW;
LOAD
    $(vCfgStartDateNum) + RecNo() - 1                                          AS _DayNum
AUTOGENERATE $(vCfgEndDateNum) - $(vCfgStartDateNum) + 1;

LET vTmpTotalW = Peek('_DayCumW', -1, 'TmpDayPlan');

// cumulative rounding: the day totals add up to exactly vCfgInvoiceLines
TmpDayLines:
LOAD
    _DayNum,
    Round(_DayCumPrev / $(vTmpTotalW) * $(vCfgInvoiceLines))                   AS _LinesBefore,
    Round(_DayCumW    / $(vTmpTotalW) * $(vCfgInvoiceLines))
  - Round(_DayCumPrev / $(vTmpTotalW) * $(vCfgInvoiceLines))                   AS _DayLines
RESIDENT TmpDayPlan;
DROP TABLE TmpDayPlan;

// ---- 2. Line skeleton ------------------------------------------------------------------------
TmpLineDays:
LOAD
    _LinesBefore + IterNo()                                                    AS InvoiceLineID,
    _DayNum                                                                    AS _InvDateNum,
    IterNo()                                                                   AS _DayLineNo
RESIDENT TmpDayLines
WHILE IterNo() <= _DayLines;
DROP TABLE TmpDayLines;

// A line opens a new invoice on the first line of a day, after vCfgMaxLinesPerInvoice lines,
// or randomly with probability vCfgNewInvoiceProb.
SET mNewInvoice = (_DayLineNo = 1 or Peek('InvoiceLineNo') >= $(vCfgMaxLinesPerInvoice) or $(fRnd(InvoiceLineID, 2)) < $(vCfgNewInvoiceProb));

TmpLines:
LOAD
    InvoiceLineID,
    _InvDateNum,
    _DayLineNo,
    If($(mNewInvoice), 1, Peek('InvoiceLineNo') + 1)                           AS InvoiceLineNo,
    RangeSum(Peek('_InvSeq'), If($(mNewInvoice), 1, 0))                        AS _InvSeq
RESIDENT TmpLineDays;
DROP TABLE TmpLineDays;

// ---- 3. Invoice header -----------------------------------------------------------------------
// Invoice numbers restart every year (INV-2025-0000001): first invoice sequence per year.
MapYearFirstInvoice:
MAPPING LOAD Year(_InvDateNum), _InvSeq
RESIDENT TmpLines
WHERE _DayLineNo = 1 and Num(Month(_InvDateNum)) = 1 and Day(_InvDateNum) = 1;

TmpInvHeader:
LOAD
    _InvSeq,
    'INV-' & Year(_HdrDate) & '-'
      & Num(_InvSeq - ApplyMap('MapYearFirstInvoice', Year(_HdrDate)) + 1, '0000000')  AS InvoiceNo,
    CustomerID,
    ApplyMap('MapCustRep', CustomerID)                                         AS SalesRepID,
    ChannelID,
    If(ChannelID = 2, 'Prepayment',
    If(_SegNo = 4,    'Net 60',
    If(_SegNo = 1,    If(_uTerms < 0.6, 'Net 45', 'Net 30'),
    If(ChannelID = 3 or _uTerms < 0.7, 'Net 30', 'Net 14'))))                  AS PaymentTerms,
    _SegNo;
// channel: mix by segment, E-Commerce trend (+11 %/yr weight) and weekend orders (mostly web)
LOAD *,
    1 - (_xChan >= _cw1) - (_xChan >= _cw1 + _cw2) - (_xChan >= _cw1 + _cw2 + _cw3)  AS ChannelID;
LOAD *,
    _uChan * (_cw1 + _cw2 + _cw3 + _cw4)                                       AS _xChan;
LOAD *,
    Pick(_SegNo, 0.70, 0.40, 0.15, 0.60) * If(_Weekend, 0.25, 1)                     AS _cw1,  // Direct Sales
    Pick(_SegNo, 0.05, 0.15, 0.30, 0.05) * Exp( 0.11 * _t) * If(_Weekend, 8, 1)      AS _cw2,  // E-Commerce
    Pick(_SegNo, 0.20, 0.30, 0.25, 0.35)                   * If(_Weekend, 0.25, 1)   AS _cw3,  // Distributor
    Pick(_SegNo, 0.05, 0.15, 0.30, 0.00) * Exp(-0.02 * _t) * If(_Weekend, 0.25, 1)   AS _cw4;  // Retail Partner
LOAD *,
    ApplyMap('MapCustSeg', CustomerID, 3)                                      AS _SegNo;
// customer inside the region: Pareto by size rank (85 %) mixed with uniform (15 %)
LOAD *,
    10001 + Mod((Pick(_RegionNo, 0, 1150, 1700, 2200, 2900, 3550, 4400)
                + Floor(Pick(_RegionNo, 1150, 550, 500, 700, 650, 850, 600)
                        * If(_uMix < 0.15, _uRank, Pow(_uRank, 2.6)))) * 2017, 5000)  AS CustomerID;
LOAD *,
    1 - (_xReg >= _rw1) - (_xReg >= _rw1 + _rw2) - (_xReg >= _rw1 + _rw2 + _rw3)
      - (_xReg >= _rw1 + _rw2 + _rw3 + _rw4) - (_xReg >= _rw1 + _rw2 + _rw3 + _rw4 + _rw5)
      - (_xReg >= _rw1 + _rw2 + _rw3 + _rw4 + _rw5 + _rw6)                     AS _RegionNo;
LOAD *,
    _uReg * (_rw1 + _rw2 + _rw3 + _rw4 + _rw5 + _rw6 + _rw7)                   AS _xReg;
// region shares drift over time (story 2): CEE grows fastest, UK & Ireland stays flat
LOAD *,
    0.27 * Exp( 0.005 * _t)                                                    AS _rw1,  // DACH
    0.11                                                                       AS _rw2,  // Benelux
    0.09 * Exp( 0.010 * _t)                                                    AS _rw3,  // Nordics
    0.15 * Exp(-0.065 * _t)                                                    AS _rw4,  // UK & Ireland
    0.13 * Exp(-0.010 * _t)                                                    AS _rw5,  // France
    0.15                                                                       AS _rw6,  // Southern Europe
    0.10 * Exp( 0.120 * _t)                                                    AS _rw7;  // CEE
LOAD
    _InvSeq,
    _InvDateNum                                                                AS _HdrDate,
    (_InvDateNum - $(vCfgStartDateNum)) / 365.25                               AS _t,
    WeekDay(_InvDateNum) >= 5                                                  AS _Weekend,
    $(fRnd(_InvSeq, 11))                                                       AS _uReg,
    $(fRnd(_InvSeq, 12))                                                       AS _uRank,
    $(fRnd(_InvSeq, 13))                                                       AS _uMix,
    $(fRnd(_InvSeq, 14))                                                       AS _uChan,
    $(fRnd(_InvSeq, 15))                                                       AS _uTerms
RESIDENT TmpLines
WHERE InvoiceLineNo = 1;

LEFT JOIN (TmpLines)
LOAD * RESIDENT TmpInvHeader;
DROP TABLE TmpInvHeader;

// ---- 4. Invoice lines --------------------------------------------------------------------------
// The %LinkKey is built here; the dimension keys stay on this table only until the
// LinkTable has been built (see tab LinkTable).
TmpInv:
LOAD
    AutoNumber(_InvDateNum & '|' & CustomerID & '|' & ProductID & '|' & SalesRepID & '|' & ChannelID, 'Link')
                                                                               AS %LinkKey,
    InvoiceLineID,
    InvoiceNo,
    InvoiceLineNo,
    Date(_InvDateNum)                                                          AS InvoiceDate,
    PaymentTerms,
    Quantity,
    UnitPrice,
    Num(DiscountPct, '0.0%')                                                   AS DiscountPct,
    GrossSales,
    Discount,
    NetSales,
    CostOfSales,
    Round(NetSales - CostOfSales, 0.01)                                        AS GrossMargin,
    // technical fields for the credit-note, budget and link-table steps (dropped later)
    _InvDateNum, _InvSeq, CustomerID, ProductID, SalesRepID, ChannelID, _CatNo, _GrpLocal;
LOAD *,
    Round(GrossSales - Discount, 0.01)                                         AS NetSales;
LOAD *,
    Round(Quantity * UnitPrice, 0.01)                                          AS GrossSales,
    Round(Round(Quantity * UnitPrice, 0.01) * DiscountPct, 0.01)               AS Discount,
    Round(Quantity * _UnitCost, 0.01)                                          AS CostOfSales;
LOAD *,
    1 + Floor(2 * Pick(_CatNo, 4, 5, 3, 4, 12, 15)          // units per line by category
                * Pick(_SegNo, 4.0, 1.8, 0.6, 2.0)          // Enterprise buys big, SMB small
                * Pick(ChannelID, 1.0, 0.45, 2.0, 1.2)      // web orders are small
                * Pow(250 / _ListPrice, 0.3)                // expensive items: fewer units
                * _uQty * _uQty)                                               AS Quantity,
    Round(_ListPrice * Pick(ChannelID, 0.98, 1.00, 0.95, 0.97)       // channel price list
                     * Pick(_SegNo, 0.94, 0.97, 1.00, 0.95), 0.01)   // contract price by segment
                                                                               AS UnitPrice,
    // line discount: E-Commerce runs vouchers and price matching (story 4)
    If(_uDiscOn < Pick(ChannelID, 0.35, 0.10, 0.20, 0.30), 0,
       Round(Pick(ChannelID, 0.02, 0.08, 0.03, 0.02)
           + _uDisc * Pick(ChannelID, 0.06, 0.17, 0.07, 0.08), 0.005))         AS DiscountPct;
LOAD *,
    1001 + (_CatNo - 1) * 100 + _ProdJ                                         AS ProductID,
    Mod(_ProdJ, 4) + 1                                                         AS _GrpLocal,
    ApplyMap('MapProdPrice', 1001 + (_CatNo - 1) * 100 + _ProdJ)               AS _ListPrice,
    ApplyMap('MapProdCost',  1001 + (_CatNo - 1) * 100 + _ProdJ)               AS _UnitCost;
// category share of lines: Notebooks 17 %, Monitors 15 %, Networking 14 %, Storage 13 %,
// Peripherals 25 %, Software & Services 16 %. Inside a category: Pareto by popularity rank.
LOAD *,
    1 - (_uCat >= 0.17) - (_uCat >= 0.32) - (_uCat >= 0.46)
      - (_uCat >= 0.59) - (_uCat >= 0.84)                                      AS _CatNo,
    Floor(100 * If(_uProdMix < 0.2, _uProd, Pow(_uProd, 2)))                   AS _ProdJ;
LOAD
    InvoiceLineID, InvoiceNo, InvoiceLineNo, _InvDateNum, _InvSeq, PaymentTerms,
    CustomerID, SalesRepID, ChannelID, _SegNo,
    $(fRnd(InvoiceLineID, 21))                                                 AS _uCat,
    $(fRnd(InvoiceLineID, 22))                                                 AS _uProd,
    $(fRnd(InvoiceLineID, 23))                                                 AS _uProdMix,
    $(fRnd(InvoiceLineID, 24))                                                 AS _uQty,
    $(fRnd(InvoiceLineID, 25))                                                 AS _uDisc,
    $(fRnd(InvoiceLineID, 26))                                                 AS _uDiscOn
RESIDENT TmpLines;
DROP TABLE TmpLines;

///$tab CreditNotes
//----------------------------------------------------------------------------------------------
//  CreditNotes (fact): exactly vCfgCreditNoteLines lines, each derived from a real invoice line
//    - inherits customer, product, sales rep and channel of the original line
//    - credit-note date = invoice date + reason-specific lag (weekend -> Monday), <= 30/09/2026
//    - CreditQty <= Quantity, CreditAmount <= NetSales, CreditCost <= CostOfSales
//  Credit propensity per invoice line = Logistics + Quality + Networking issue + Commercial.
//----------------------------------------------------------------------------------------------
SET mPLogistics  = (0.030 * Pick(_CatNo, 1.2, 1.5, 0.5, 0.9, 1.0, 0.1) * If(ChannelID = 2, 1.5, 1));
SET mPQuality    = (0.022 * Pick(_CatNo, 1.2, 1.0, 0.35, 1.2, 0.9, 0.3));
// Story 1: Networking quality issue, worst for wireless access points, ramps up linearly
SET mPIssue      = If(_CatNo = 3, 0.085 * Pick(_GrpLocal, 1.2, 1.8, 0.8, 0.2) * RangeMin(1, RangeMax(0, (_InvDateNum - $(vCfgIssueStartNum)) / ($(vCfgEndDateNum) - $(vCfgIssueStartNum)))), 0);
SET mPCommercial = (0.035 * If(ChannelID = 2, 1.8, 1) * Pick(_CatNo, 1, 1, 0.6, 1, 1, 1.4));

// Scale the propensities so that ~8 % more candidates than needed are drawn; the surplus is
// trimmed at random below, which keeps every mix intact and makes the count exact.
TmpCNPSum:
LOAD Sum($(mPLogistics) + $(mPQuality) + $(mPIssue) + $(mPCommercial))     AS _PSum
RESIDENT TmpInv;
LET vTmpCNScale = 1.08 * $(vCfgCreditNoteLines) / Peek('_PSum', 0, 'TmpCNPSum');
DROP TABLE TmpCNPSum;

TmpCNCand:
LOAD *,
    $(fRnd(InvoiceLineID, 37))                                                 AS _TrimKey
WHERE _CNDateNum <= $(vCfgEndDateNum);                     // credits after the window: not yet issued
LOAD *,
    _CNRaw + Pick(WeekDay(_CNRaw) + 1, 0, 0, 0, 0, 0, 2, 1)                    AS _CNDateNum;   // weekend -> Monday
LOAD *,
    _InvDateNum
  + Pick(ReturnReasonID, 2, 3, 7, 14, 2, 5, 1, 20)                             // minimum lag (days)
  + Floor($(fRnd(_CNDocKey, 33)) * Pick(ReturnReasonID, 9, 10, 19, 77, 9, 31, 7, 41))
                                                                               AS _CNRaw;
LOAD *,
    _InvSeq * 10 + ReturnReasonID                                              AS _CNDocKey;    // one credit note per invoice and reason
LOAD *,
    If(_g < _pL,              1 - (_uSub >= 0.45) - (_uSub >= 0.75),           // damaged / wrong item / late
    If(_g < _pL + _pQ,        If(_uSub < 0.70, 4, 5),                         // quality defect / dead on arrival
    If(_g < _pL + _pQ + _pX,  4,                                              // networking issue -> quality defect
                              6 - (_uSub >= 0.40) - (_uSub >= 0.70))))         AS ReturnReasonID,  // pricing / cancelled / goodwill
    -(_g >= _pL + _pQ and _g < _pL + _pQ + _pX)                                AS _IsIssue;
LOAD *,
    $(fRnd(InvoiceLineID, 32)) * (_pL + _pQ + _pX + _pC)                       AS _g,
    $(fRnd(InvoiceLineID, 34))                                                 AS _uSub;
LOAD
    InvoiceLineID, InvoiceNo, _InvDateNum, _InvSeq, Quantity, NetSales, CostOfSales,
    CustomerID, ProductID, SalesRepID, ChannelID,
    $(mPLogistics)                                                             AS _pL,
    $(mPQuality)                                                               AS _pQ,
    $(mPIssue)                                                                 AS _pX,
    $(mPCommercial)                                                            AS _pC
RESIDENT TmpInv
WHERE $(fRnd(InvoiceLineID, 31)) < $(vTmpCNScale) * ($(mPLogistics) + $(mPQuality) + $(mPIssue) + $(mPCommercial));

// random trim to the exact number of lines
TmpCNRanked:
NOCONCATENATE
LOAD *, RowNo() AS _TrimRank
RESIDENT TmpCNCand
ORDER BY _TrimKey;
DROP TABLE TmpCNCand;

LET vTmpCNCandidates = NoOfRows('TmpCNRanked');
TRACE Credit-note candidates: $(vTmpCNCandidates) (needed: $(vCfgCreditNoteLines));

// chronological numbering: CN-<year>-<sequence>, lines numbered inside each credit note
TmpCN:
NOCONCATENATE
LOAD *,
    RowNo()                                                                    AS CreditNoteLineID,
    If(_CNDocKey = Peek('_CNDocKey'), Peek('CreditNoteLineNo') + 1, 1)         AS CreditNoteLineNo,
    If(_CNDocKey = Peek('_CNDocKey'), Peek('_CNYearSeq'),
       If(Year(_CNDateNum) = Year(Peek('_CNDateNum')), Peek('_CNYearSeq') + 1, 1))  AS _CNYearSeq
RESIDENT TmpCNRanked
WHERE _TrimRank <= $(vCfgCreditNoteLines)
ORDER BY _CNDateNum, _CNDocKey, InvoiceLineID;
DROP TABLE TmpCNRanked;

CreditNotes:
LOAD
    AutoNumber(_CNDateNum & '|' & CustomerID & '|' & ProductID & '|' & SalesRepID & '|' & ChannelID, 'Link')
                                                                               AS %LinkKey,
    CreditNoteLineID,
    'CN-' & Year(_CNDateNum) & '-' & Num(_CNYearSeq, '0000000')                AS CreditNoteNo,
    CreditNoteLineNo,
    Date(_CNDateNum)                                                           AS CreditNoteDate,
    InvoiceNo                                                                  AS CN_OrigInvoiceNo,
    InvoiceLineID                                                              AS CN_OrigInvoiceLineID,
    ReturnReasonID,
    CreditQty,
    CreditAmount,
    CreditCost,
    // technical fields (dropped after the link table is built)
    _CNDateNum, CustomerID, ProductID, SalesRepID, ChannelID,
    -(CreditQty <= Quantity and CreditAmount > 0 and CreditAmount <= NetSales + 0.001
      and CreditCost >= 0 and CreditCost <= CostOfSales + 0.001
      and _CNDateNum >= _InvDateNum and _CNDateNum <= $(vCfgEndDateNum))         AS _RuleOK;
LOAD *,
    If(CreditQty > 0, Round(NetSales * CreditQty / Quantity, 0.01),
       Round(NetSales * If(ReturnReasonID = 6, 0.03 + 0.09 * _uAmt, 0.05 + 0.10 * _uAmt), 0.01))
                                                                               AS CreditAmount,
    If(CreditQty > 0, Round(CostOfSales * CreditQty / Quantity, 0.01), 0)      AS CreditCost;   // returned goods: cost reversal
LOAD *,
    Pick(ReturnReasonID,
         RangeMax(1, Round(Quantity * 0.5 * _uAmt)),                           // 1 damaged: part of the delivery
         Quantity,                                                             // 2 wrong item: whole line
         RangeMax(1, Round(Quantity * (0.3 + 0.7 * _uAmt))),                   // 3 late delivery: rest cancelled
         RangeMax(1, Round(Quantity * If(_IsIssue, 0.4 + 0.6 * _uAmt, 0.15 + 0.6 * _uAmt))),  // 4 quality defect
         RangeMax(1, Round(Quantity * 0.1 * _uAmt)),                           // 5 dead on arrival
         0,                                                                    // 6 pricing error: value only
         Quantity,                                                             // 7 order cancelled: whole line
         0)                                                                    // 8 goodwill: value only
                                                                               AS CreditQty;
LOAD *,
    $(fRnd(InvoiceLineID, 35))                                                 AS _uAmt
RESIDENT TmpCN;
DROP TABLE TmpCN;

// rule check: CreditQty <= Quantity, 0 < CreditAmount <= NetSales, 0 <= CreditCost <= CostOfSales,
// invoice date <= credit-note date <= data end date  (expected: 0 violations)
TmpCNCheck:
LOAD Sum(1 - _RuleOK) AS _Violations RESIDENT CreditNotes;
LET vTmpCNViolations = Peek('_Violations', 0, 'TmpCNCheck');
TRACE Credit-note rule violations: $(vTmpCNViolations);
DROP TABLE TmpCNCheck;

///$tab Budget
//----------------------------------------------------------------------------------------------
//  Budget (fact): sales rep x month, 01/2024 .. 12/2026 (40 x 36 = 1,440 rows)
//  Built like a real plan: an annual target per rep (from the actual net-revenue run rate),
//  phased by the seasonal profile. Budget is compared with NetRevenue (sales - credits).
//  Target achievement per team and year is set in MapTeamTarget (story 3: UK & Ireland
//  misses the 2026 budget by ~12 %; all other teams land between 98 % and 106 %).
//----------------------------------------------------------------------------------------------

// 1. actual net revenue per rep and month (sales by invoice date, credits by credit-note date)
TmpRepMonth:
LOAD _BRep, _BYear, _BMonth, Sum(_BAmt) AS _A, Sum(_BGM) AS _AGM
GROUP BY _BRep, _BYear, _BMonth;
LOAD SalesRepID AS _BRep, Year(_InvDateNum) AS _BYear, Num(Month(_InvDateNum)) AS _BMonth,
     NetSales AS _BAmt, GrossMargin AS _BGM
RESIDENT TmpInv;

CONCATENATE (TmpRepMonth)
LOAD _BRep, _BYear, _BMonth, Sum(_BAmt) AS _A, Sum(_BGM) AS _AGM
GROUP BY _BRep, _BYear, _BMonth;
LOAD SalesRepID AS _BRep, Year(_CNDateNum) AS _BYear, Num(Month(_CNDateNum)) AS _BMonth,
     -CreditAmount AS _BAmt, CreditCost - CreditAmount AS _BGM
RESIDENT CreditNotes;

// 2. seasonal profile: share of each calendar month in the complete years
TmpSeason:
LOAD _BMonth, Sum(_A) AS _SeasonA
RESIDENT TmpRepMonth
WHERE _BYear < Year($(vCfgEndDateNum))
GROUP BY _BMonth;

TmpSeasonTot:
LOAD Sum(_SeasonA) AS _SeasonTot,
     Sum(If(_BMonth <= Month($(vCfgEndDateNum)), _SeasonA)) AS _SeasonYTD
RESIDENT TmpSeason;
LET vTmpSeasonTot      = Peek('_SeasonTot', 0, 'TmpSeasonTot');
LET vTmpSeasonYTDShare = Peek('_SeasonYTD', 0, 'TmpSeasonTot') / Peek('_SeasonTot', 0, 'TmpSeasonTot');

MapSeason:
MAPPING LOAD _BMonth, _SeasonA / $(vTmpSeasonTot) RESIDENT TmpSeason;
DROP TABLES TmpSeason, TmpSeasonTot;

// 3. target achievement per team and year (actual / budget)
MapTeamTarget:
MAPPING LOAD _TeamNo * 10000 + _Year, _Target INLINE [
_TeamNo, _Year, _Target
1, 2024, 1.03
1, 2025, 1.01
1, 2026, 1.02
2, 2024, 0.98
2, 2025, 1.02
2, 2026, 0.99
3, 2024, 1.01
3, 2025, 0.99
3, 2026, 1.04
4, 2024, 0.97
4, 2025, 1.03
4, 2026, 1.01
5, 2024, 0.99
5, 2025, 0.95
5, 2026, 0.88
6, 2024, 1.02
6, 2025, 0.98
6, 2026, 1.00
7, 2024, 1.00
7, 2025, 1.04
7, 2026, 1.03
8, 2024, 1.04
8, 2025, 1.06
8, 2026, 1.05
];

// 4. annual target per rep = annualised actual x rep noise / team achievement,
//    normalised so that the team total hits its target achievement exactly
TmpRepYear:
LOAD
    _BRep,
    _BYear,
    Div(_BRep - 101, 5) + 1                                                    AS _TeamNo,
    _AYear / If(_BYear = Year($(vCfgEndDateNum)), $(vTmpSeasonYTDShare), 1)    AS _RunRate,
    _AGMYear / _AYear                                                          AS _GMPct,
    0.93 + 0.14 * $(fRnd(_BRep * 10 + _BYear, 41))                             AS _RepNoise;
LOAD _BRep, _BYear, Sum(_A) AS _AYear, Sum(_AGM) AS _AGMYear
RESIDENT TmpRepMonth
GROUP BY _BRep, _BYear;
DROP TABLE TmpRepMonth;

LEFT JOIN (TmpRepYear)
LOAD _TeamNo, _BYear, Sum(_RunRate) / Sum(_RunRate * _RepNoise) AS _TeamNorm
RESIDENT TmpRepYear
GROUP BY _TeamNo, _BYear;

MapRepBudget:
MAPPING LOAD _BRep * 10000 + _BYear,
    _RunRate * _RepNoise * _TeamNorm / ApplyMap('MapTeamTarget', _TeamNo * 10000 + _BYear, 1)
RESIDENT TmpRepYear;
MapRepGMPct:
MAPPING LOAD _BRep * 10000 + _BYear, _GMPct RESIDENT TmpRepYear;
DROP TABLE TmpRepYear;

// 5. budget rows: rep x month, phased by season, rounded to EUR 100
Budget:
LOAD
    AutoNumber(_BudDateNum & '|||' & SalesRepID & '|', 'Link')                 AS %LinkKey,   // customer, product, channel = null
    BudgetID,
    BudgetNetSales,
    Round(BudgetNetSales * ApplyMap('MapRepGMPct', SalesRepID * 10000 + _BYear, 0.2)
          * (0.99 + 0.02 * $(fRnd(BudgetID, 44))), 100)                        AS BudgetGrossMargin,
    // technical fields (dropped after the link table is built)
    _BudDateNum, SalesRepID;
LOAD *,
    Round(ApplyMap('MapRepBudget', SalesRepID * 10000 + _BYear, 0)
          * ApplyMap('MapSeason', _BMonth, 1 / 12)
          * (0.985 + 0.03 * $(fRnd(BudgetID, 43))), 100)                       AS BudgetNetSales;
LOAD
    RecNo()                                                                    AS BudgetID,
    101 + Div(RecNo() - 1, 36)                                                 AS SalesRepID,
    Floor(AddMonths($(vCfgStartDateNum), Mod(RecNo() - 1, 36)))                AS _BudDateNum,
    Year($(vCfgStartDateNum)) + Div(Mod(RecNo() - 1, 36), 12)                  AS _BYear,
    Mod(RecNo() - 1, 12) + 1                                                   AS _BMonth
AUTOGENERATE $(vCfgSalesReps) * 36;

///$tab LinkTable
//----------------------------------------------------------------------------------------------
//  LinkTable: one row per distinct key combination of the three facts
//    %LinkKey, %DateKey, CustomerID, ProductID, SalesRepID, ChannelID, LinkSource
//  LinkSource = Invoice | CreditNote | Invoice|CreditNote (shared combination) | Budget
//  Budget rows: %DateKey = first day of the month, only SalesRepID set.
//----------------------------------------------------------------------------------------------
TmpCNKeys:
LOAD DISTINCT %LinkKey AS _CNKey RESIDENT CreditNotes;

LinkTable:
LOAD DISTINCT
    %LinkKey,
    _InvDateNum                                                                AS %DateKey,
    CustomerID,
    ProductID,
    SalesRepID,
    ChannelID,
    If(Exists(_CNKey, %LinkKey), 'Invoice|CreditNote', 'Invoice')              AS LinkSource
RESIDENT TmpInv;

TmpInvKeys:
LOAD %LinkKey AS _InvKey RESIDENT LinkTable;

CONCATENATE (LinkTable)
LOAD DISTINCT
    %LinkKey,
    _CNDateNum                                                                 AS %DateKey,
    CustomerID,
    ProductID,
    SalesRepID,
    ChannelID,
    'CreditNote'                                                               AS LinkSource
RESIDENT CreditNotes
WHERE NOT Exists(_InvKey, %LinkKey);

CONCATENATE (LinkTable)
LOAD
    %LinkKey,
    _BudDateNum                                                                AS %DateKey,
    SalesRepID,
    'Budget'                                                                   AS LinkSource
RESIDENT Budget;

DROP TABLES TmpCNKeys, TmpInvKeys;

// facts keep only %LinkKey (and ReturnReasonID on CreditNotes)
DROP FIELDS _InvDateNum, _InvSeq, CustomerID, ProductID, SalesRepID, ChannelID, _CatNo, _GrpLocal FROM TmpInv;
RENAME TABLE TmpInv TO Invoices;
DROP FIELDS _CNDateNum, CustomerID, ProductID, SalesRepID, ChannelID, _RuleOK FROM CreditNotes;
DROP FIELDS _BudDateNum, SalesRepID FROM Budget;

///$tab Variables
//----------------------------------------------------------------------------------------------
//  Expression variables (data contract). Use them in the UI as $(vName).
//  Every variable holds a complete, self-contained expression: no nested $() inside, so
//  nothing is expanded too early and every variable can be evaluated on its own.
//  Measures are written once as templates:  #S# = set expression, #M# = extra set modifiers.
//----------------------------------------------------------------------------------------------

// ---- Period sets: ignore every calendar selection, then apply one flag ------------------------
SET vTmpCalClear = Year=,Quarter=,Month=,YearQuarter=,YearMonth=,Week=,Weekday=,Day=,Date=;
FOR EACH vTmpP IN 'CYTD', 'PYTD', 'R12', 'PR12', 'CM', 'PM', 'PYM'
    LET vSet$(vTmpP) = '{<$(vTmpCalClear),Flag_$(vTmpP)={1}>}';
NEXT vTmpP

// ---- Measure templates -------------------------------------------------------------------------
SET vTpl_NetSales        = Sum(#S#NetSales);
SET vTpl_GrossSales      = Sum(#S#GrossSales);
SET vTpl_Discount        = Sum(#S#Discount);
SET vTpl_COGS            = Sum(#S#CostOfSales);
SET vTpl_GrossMargin     = Sum(#S#GrossMargin);
SET vTpl_GrossMarginPct  = (Sum(#S#GrossMargin) / Sum(#S#NetSales));
SET vTpl_CreditAmount    = Sum(#S#CreditAmount);
SET vTpl_CreditCost      = Sum(#S#CreditCost);
SET vTpl_CreditQty       = Sum(#S#CreditQty);
SET vTpl_Quantity        = Sum(#S#Quantity);
SET vTpl_NetRevenue      = (Sum(#S#NetSales) - Sum(#S#CreditAmount));
SET vTpl_NetMargin       = (Sum(#S#GrossMargin) - Sum(#S#CreditAmount) + Sum(#S#CreditCost));
SET vTpl_NetMarginPct    = ((Sum(#S#GrossMargin) - Sum(#S#CreditAmount) + Sum(#S#CreditCost)) / (Sum(#S#NetSales) - Sum(#S#CreditAmount)));
SET vTpl_CreditRate      = (Sum(#S#CreditAmount) / Sum(#S#NetSales));
SET vTpl_DiscountRate    = (Sum(#S#Discount) / Sum(#S#GrossSales));
SET vTpl_Invoices        = Count(#S#DISTINCT InvoiceNo);
SET vTpl_CreditNotes     = Count(#S#DISTINCT CreditNoteNo);
SET vTpl_ActiveCustomers = Count({<#M#LinkSource={"*Invoice*"}>} DISTINCT CustomerID);
SET vTpl_AvgInvoiceValue = (Sum(#S#NetSales) / Count(#S#DISTINCT InvoiceNo));
SET vTpl_Budget          = Sum(#S#BudgetNetSales);
SET vTpl_BudgetAch       = ((Sum(#S#NetSales) - Sum(#S#CreditAmount)) / Sum(#S#BudgetNetSales));

// ---- Base measures (respect all selections) ----------------------------------------------------
FOR EACH vTmpM IN 'NetSales', 'GrossSales', 'Discount', 'COGS', 'GrossMargin', 'GrossMarginPct', 'CreditAmount', 'CreditCost', 'CreditQty', 'Quantity', 'NetRevenue', 'NetMargin', 'NetMarginPct', 'CreditRate', 'DiscountRate', 'Invoices', 'CreditNotes', 'ActiveCustomers', 'AvgInvoiceValue', 'Budget', 'BudgetAch'
    LET v$(vTmpM) = Replace(Replace('$(vTpl_$(vTmpM))', '#S#', ''), '#M#', '');
NEXT vTmpM

// Round 2 fix (QA Q-001, lead decision): vBudget = budget for the selection (full year, for "full-year budget" displays);
// vBudgetToDate = budget months up to the data end date; vBudgetAch = vNetRevenue / vBudgetToDate.
// (The budget covers all of 2026 but actuals stop on 30/09/2026: a plain ratio showed 72 % for Year=2026.)
LET vBudgetToDate = 'Sum({<%DateKey={"<=$(vCfgEndDateNum)"}>} BudgetNetSales)';
LET vBudgetAch = '((Sum(NetSales) - Sum(CreditAmount)) / Sum({<%DateKey={"<=$(vCfgEndDateNum)"}>} BudgetNetSales))';

// Full calendar year sets (current year of the data end date and the year before), all other calendar selections cleared
LET vSetCY = '{<Year={' & Year($(vCfgEndDateNum)) & '},Quarter=,Month=,YearQuarter=,YearMonth=,Week=,Weekday=,Day=,Date=>}';
LET vSetPY = '{<Year={' & (Year($(vCfgEndDateNum))-1) & '},Quarter=,Month=,YearQuarter=,YearMonth=,Week=,Weekday=,Day=,Date=>}';

// ---- Period measures v<Measure>_<Period> -------------------------------------------------------
FOR EACH vTmpM IN 'NetSales', 'NetRevenue', 'CreditAmount', 'GrossMargin', 'NetMargin', 'NetMarginPct', 'CreditRate', 'DiscountRate', 'Invoices', 'AvgInvoiceValue', 'ActiveCustomers', 'Budget', 'BudgetAch'
    FOR EACH vTmpP IN 'CYTD', 'PYTD', 'R12', 'PR12', 'CM', 'PM', 'PYM'
        LET v$(vTmpM)_$(vTmpP) = Replace(Replace('$(vTpl_$(vTmpM))', '#S#', '$(vSet$(vTmpP)) '), '#M#', '$(vTmpCalClear),Flag_$(vTmpP)={1},');
    NEXT vTmpP
NEXT vTmpM

// ---- Growth CYTD vs PYTD: ratio for amounts and counts (0.05 = +5 %) ---------------------------
FOR EACH vTmpM IN 'NetSales', 'NetRevenue', 'GrossMargin', 'NetMargin', 'Invoices'
    LET v$(vTmpM)_YoY = '((' & '$(v$(vTmpM)_CYTD)' & ') / (' & '$(v$(vTmpM)_PYTD)' & ') - 1)';
NEXT vTmpM

// ---- Growth CYTD vs PYTD for ratios: difference in percentage points (1.5 = +1.5 pp) --------
FOR EACH vTmpM IN 'NetMarginPct', 'CreditRate', 'DiscountRate'
    LET v$(vTmpM)_YoYpp = '((' & '$(v$(vTmpM)_CYTD)' & ') - (' & '$(v$(vTmpM)_PYTD)' & ')) * 100';
NEXT vTmpM

// ---- UI defaults and number formats --------------------------------------------------------------
SET vTopN     = 10;
SET vShowHelp = 1;
SET vUI_TrendMeasure = 1;   // Designer UI variable: SALES_CH_TREND measure 1..6 (Net Sales, Net Revenue, Gross Margin, GM %, Discount Rate, Invoices), set by SALES_TRD_M1..M6
LET vDataEndDate    = Date($(vCfgEndDateNum), 'DD/MM/YYYY');
LET vDataEndDateNum = $(vCfgEndDateNum);
SET vFmtMoney = '€ #,##0';
SET vFmtPct   = '0.0%';

///$tab Cleanup
//----------------------------------------------------------------------------------------------
//  Cleanup: table/field comments, remove script-only helper variables, log the row counts
//----------------------------------------------------------------------------------------------
COMMENT TABLE Invoices      WITH 'Fact: invoice lines (EUR). Joined to dimensions via %LinkKey.';
COMMENT TABLE CreditNotes   WITH 'Fact: credit-note lines derived from invoice lines. Original line in CN_OrigInvoiceLineID (not associated).';
COMMENT TABLE Budget        WITH 'Fact: budget per sales rep and month (compare with NetRevenue).';
COMMENT TABLE LinkTable     WITH 'Link table: distinct key combinations of Invoices, CreditNotes and Budget.';
COMMENT TABLE Calendar      WITH 'Calendar 2024-2026; flags relative to the data end date 30/09/2026.';
COMMENT FIELD NetSales      WITH 'GrossSales - Discount (EUR)';
COMMENT FIELD GrossMargin   WITH 'NetSales - CostOfSales (EUR)';
COMMENT FIELD CreditAmount  WITH 'Credited value, positive, <= original NetSales (EUR)';
COMMENT FIELD CreditCost    WITH 'Cost reversal for returned goods (EUR)';
COMMENT FIELD LinkSource    WITH 'Which fact uses the key combination: Invoice, CreditNote, Invoice|CreditNote, Budget';

// helper variables used only while the script runs
SET fRnd = ;
SET mNewInvoice = ;
SET mPLogistics = ;
SET mPQuality = ;
SET mPIssue = ;
SET mPCommercial = ;
FOR EACH vTmpM IN 'NetSales', 'GrossSales', 'Discount', 'COGS', 'GrossMargin', 'GrossMarginPct', 'CreditAmount', 'CreditCost', 'CreditQty', 'Quantity', 'NetRevenue', 'NetMargin', 'NetMarginPct', 'CreditRate', 'DiscountRate', 'Invoices', 'CreditNotes', 'ActiveCustomers', 'AvgInvoiceValue', 'Budget', 'BudgetAch'
    LET vTpl_$(vTmpM) = Null();
NEXT vTmpM

FOR EACH vTmpT IN 'Invoices', 'CreditNotes', 'Budget', 'LinkTable', 'Calendar', 'Customers', 'Products', 'SalesReps', 'Channels', 'ReturnReasons'
    LET vTmpRows = NoOfRows('$(vTmpT)');
    TRACE Rows $(vTmpT): $(vTmpRows);
NEXT vTmpT

LET vTmpTotalW = Null();
LET vTmpCNScale = Null();
LET vTmpCNCandidates = Null();
LET vTmpCNViolations = Null();
LET vTmpSeasonTot = Null();
LET vTmpSeasonYTDShare = Null();
LET vTmpCalClear = Null();
LET vTmpRows = Null();
LET vTmpP = Null();
LET vTmpM = Null();
LET vTmpT = Null();
